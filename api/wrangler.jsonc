{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "filinglens-sec-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filinglens-sec-data",
      "database_id": "c6c097d1-51f7-4d45-b938-c2c7e16f4950",
      "migrations_dir": "migrations"
    }
  ]
}
