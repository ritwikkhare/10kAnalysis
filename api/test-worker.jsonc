{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "filinglens-sec-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filinglens-sec-data-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "example/filinglens-test",
    "TURNSTILE_ACTION": "analyze_ticker",
    "TURNSTILE_HOSTNAMES": "example.test",
    "AI_ENABLED": "true",
    "AI_MODEL": "mock-workers-ai"
  },
  "queues": {
    "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "filinglens-analysis-test" }],
    "consumers": [{
      "queue": "filinglens-analysis-test",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "retry_delay": 30
    }]
  },
  "ratelimits": [
    { "name": "TICKER_SEARCH_RATE_LIMITER", "namespace_id": "9001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ONBOARDING_RATE_LIMITER", "namespace_id": "9002", "simple": { "limit": 3, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "9003", "simple": { "limit": 6, "period": 60 } }
  ]
}
